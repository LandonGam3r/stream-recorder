# Copy this file to docker/.env and fill it in. .env is never part of the image or the repository.

# Passphrase that encrypts your Twitch, YouTube and Claude keys: 16 or more letters and digits.
# Make one up (or let the dashboard's first page make one), save it somewhere safe, and never change it.
REC_KEY=

# Your time zone, so times in chat and recordings match your clock (a name from the tz database).
TZ=Europe/Amsterdam
